diff -ruN a/newlib/libc/machine/riscv/memmove.S b/newlib/libc/machine/riscv/memmove.S
--- a/newlib/libc/machine/riscv/memmove.S
+++ b/newlib/libc/machine/riscv/memmove.S
@@ -1,3 +1,37 @@
+/* -mnano (riscv32-nano-elf-gcc): x0, ra, sp, a0..a2 only. */
+#ifdef __riscv_nano
+
+/* void *memmove (void *d, const void *s, size_t n): forward if d <= s, else backward. */
+	.section .text.memmove
+	.global memmove
+	.type	memmove, @function
+memmove:
+	addi	sp, sp, -8
+	sw	ra, 4(sp)
+	sw	a0, 0(sp)
+	bleu	a0, a1, 2f
+	add	a0, a0, a2		/* backward: from the ends */
+	add	a1, a1, a2
+1:	beqz	a2, 3f
+	addi	a0, a0, -1
+	addi	a1, a1, -1
+	lbu	ra, 0(a1)
+	sb	ra, 0(a0)
+	addi	a2, a2, -1
+	j	1b
+2:	beqz	a2, 3f
+	lbu	ra, 0(a1)
+	sb	ra, 0(a0)
+	addi	a0, a0, 1
+	addi	a1, a1, 1
+	addi	a2, a2, -1
+	j	2b
+3:	lw	a0, 0(sp)
+	lw	ra, 4(sp)
+	addi	sp, sp, 8
+	ret
+	.size	memmove, .-memmove
+#else /* !__riscv_nano */
 /* Copyright (c) 2019  SiFive Inc. All rights reserved.
 
    This copyrighted material is made available to anyone wishing to use,
