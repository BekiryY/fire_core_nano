diff -ruN a/newlib/libc/machine/riscv/setjmp.S b/newlib/libc/machine/riscv/setjmp.S
--- a/newlib/libc/machine/riscv/setjmp.S
+++ b/newlib/libc/machine/riscv/setjmp.S
@@ -1,3 +1,29 @@
+/* -mnano (riscv32-nano-elf-gcc): x0, ra, sp, a0..a2 only. */
+#ifdef __riscv_nano
+
+/* int setjmp (jmp_buf): -mnano has no callee-saved registers, so ra and sp are the
+   whole context. void longjmp (jmp_buf, int val): returns val, or 1 if val is 0. */
+	.section .text.setjmp
+	.global setjmp
+	.type	setjmp, @function
+setjmp:
+	sw	ra, 0(a0)
+	sw	sp, 4(a0)
+	li	a0, 0
+	ret
+	.size	setjmp, .-setjmp
+
+	.section .text.longjmp
+	.global longjmp
+	.type	longjmp, @function
+longjmp:
+	lw	ra, 0(a0)
+	lw	sp, 4(a0)
+	seqz	a0, a1
+	add	a0, a0, a1
+	ret
+	.size	longjmp, .-longjmp
+#else /* !__riscv_nano */
 /* Copyright (c) 2017  SiFive Inc. All rights reserved.
 
    This copyrighted material is made available to anyone wishing to use,
@@ -100,3 +126,4 @@
 	add  a0, a0, a1   # a0 = (a1 == 0) ? 1 : a1
 	ret
 	.size	longjmp, .-longjmp
+#endif /* __riscv_nano */
