diff -ruN a/newlib/libc/machine/riscv/memcpy-asm.S b/newlib/libc/machine/riscv/memcpy-asm.S
--- a/newlib/libc/machine/riscv/memcpy-asm.S
+++ b/newlib/libc/machine/riscv/memcpy-asm.S
@@ -1,3 +1,27 @@
+/* -mnano (riscv32-nano-elf-gcc): x0, ra, sp, a0..a2 only. */
+#ifdef __riscv_nano
+
+/* void *memcpy (void *d, const void *s, size_t n): ra is the byte temporary. */
+	.section .text.memcpy
+	.global memcpy
+	.type	memcpy, @function
+memcpy:
+	addi	sp, sp, -8
+	sw	ra, 4(sp)
+	sw	a0, 0(sp)
+1:	beqz	a2, 2f
+	lbu	ra, 0(a1)
+	sb	ra, 0(a0)
+	addi	a0, a0, 1
+	addi	a1, a1, 1
+	addi	a2, a2, -1
+	j	1b
+2:	lw	a0, 0(sp)
+	lw	ra, 4(sp)
+	addi	sp, sp, 8
+	ret
+	.size	memcpy, .-memcpy
+#else /* !__riscv_nano */
 /* Copyright (c) 2019  SiFive Inc. All rights reserved.
 
    This copyrighted material is made available to anyone wishing to use,
@@ -32,3 +56,4 @@
 
   .size	memcpy, .-memcpy
 #endif
+#endif /* __riscv_nano */
