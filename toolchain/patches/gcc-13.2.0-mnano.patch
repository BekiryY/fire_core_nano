diff -ruN a/libgcc/config/riscv/nano-div64.c b/libgcc/config/riscv/nano-div64.c
--- a/libgcc/config/riscv/nano-div64.c
+++ b/libgcc/config/riscv/nano-div64.c
@@ -0,0 +1,53 @@
+/* -mnano 64-bit division: restoring shift-subtract, 64 iterations; small, not fast.
+   Division by zero gives the RISC-V results (unsigned quotient all ones, remainder
+   the dividend; signed as the RV64 div / rem instructions).  */
+
+typedef unsigned long long u64;
+typedef long long s64;
+
+static u64
+nano_udivmod (u64 n, u64 d, u64 *rem)
+{
+  u64 r = 0;
+  for (int i = 0; i < 64; i++)
+    {
+      r = (r << 1) | (n >> 63);
+      n <<= 1;
+      if (r >= d)
+	{
+	  r -= d;
+	  n |= 1;
+	}
+    }
+  *rem = r;
+  return n;
+}
+
+u64 __udivdi3 (u64 n, u64 d) { u64 r; return nano_udivmod (n, d, &r); }
+u64 __umoddi3 (u64 n, u64 d) { u64 r; nano_udivmod (n, d, &r); return r; }
+
+u64
+__udivmoddi4 (u64 n, u64 d, u64 *rem)
+{
+  u64 r;
+  u64 q = nano_udivmod (n, d, &r);
+  if (rem)
+    *rem = r;
+  return q;
+}
+
+s64
+__divdi3 (s64 a, s64 b)
+{
+  u64 r;
+  u64 q = nano_udivmod (a < 0 ? -(u64) a : (u64) a, b < 0 ? -(u64) b : (u64) b, &r);
+  return (a < 0) != (b < 0) && b != 0 ? -(s64) q : (s64) q;
+}
+
+s64
+__moddi3 (s64 a, s64 b)
+{
+  u64 r;
+  nano_udivmod (a < 0 ? -(u64) a : (u64) a, b < 0 ? -(u64) b : (u64) b, &r);
+  return a < 0 ? -(s64) r : (s64) r;
+}
