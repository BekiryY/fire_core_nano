+++ b/libgcc/config/riscv/div.S
@@ -25,6 +25,89 @@
 
 #include "riscv-asm.h"
 
+#ifdef __riscv_nano
+/* -mnano division: a0..a2, ra, sp only.  __udivsi3 is restoring division
+   (32 iterations, ra the counter) and leaves the remainder in a2.  Division
+   by zero gives the RISC-V results for the unsigned forms (quotient all ones,
+   remainder the dividend).  */
+  .text
+  .align 2
+FUNC_BEGIN (__udivsi3)
+  addi  sp, sp, -4
+  sw    ra, 0(sp)
+  li    a2, 0
+  li    ra, 32
+1:
+  slli  a2, a2, 1
+  bgez  a0, 2f
+  ori   a2, a2, 1
+2:
+  slli  a0, a0, 1
+  bltu  a2, a1, 3f
+  sub   a2, a2, a1
+  ori   a0, a0, 1
+3:
+  addi  ra, ra, -1
+  bnez  ra, 1b
+  lw    ra, 0(sp)
+  addi  sp, sp, 4
+  ret
+FUNC_END (__udivsi3)
+
+FUNC_BEGIN (__umodsi3)
+  addi  sp, sp, -4
+  sw    ra, 0(sp)
+  call  __udivsi3
+  mv    a0, a2
+  lw    ra, 0(sp)
+  addi  sp, sp, 4
+  ret
+FUNC_END (__umodsi3)
+
+/* Signed: truncate toward zero, remainder has the sign of the dividend.  */
+FUNC_BEGIN (__divsi3)
+  addi  sp, sp, -8
+  sw    ra, 4(sp)
+  xor   a2, a0, a1
+  sw    a2, 0(sp)
+  bgez  a0, 1f
+  neg   a0, a0
+1:
+  bgez  a1, 2f
+  neg   a1, a1
+2:
+  call  __udivsi3
+  lw    a2, 0(sp)
+  bgez  a2, 3f
+  neg   a0, a0
+3:
+  lw    ra, 4(sp)
+  addi  sp, sp, 8
+  ret
+FUNC_END (__divsi3)
+
+FUNC_BEGIN (__modsi3)
+  addi  sp, sp, -8
+  sw    ra, 4(sp)
+  sw    a0, 0(sp)
+  bgez  a0, 1f
+  neg   a0, a0
+1:
+  bgez  a1, 2f
+  neg   a1, a1
+2:
+  call  __udivsi3
+  mv    a0, a2
+  lw    a2, 0(sp)
+  bgez  a2, 3f
+  neg   a0, a0
+3:
+  lw    ra, 4(sp)
+  addi  sp, sp, 8
+  ret
+FUNC_END (__modsi3)
+#else /* !__riscv_nano */
